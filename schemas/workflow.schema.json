{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipubs-cloud.github.io/open-flow/schemas/workflow.schema.json",
  "title": "Open Workflow Framework Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "purpose", "steps"],
  "properties": {
    "id": {"type": "string", "pattern": "^OWF-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "mode": {"enum": ["observe", "plan", "guided", "assisted", "autonomous"]},
    "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["observe", "plan", "guided", "assisted", "autonomous"]}},
    "inputs": {"type": "array", "items": {"type": ["string", "object"]}},
    "outputs": {"type": "array", "items": {"type": ["string", "object"]}},
    "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "agent": {"type": "string"},
          "skill": {"type": "string"},
          "requires_confirmation": {"type": "boolean"},
          "verification": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "gates": {"type": "array", "items": {"type": "string"}},
    "safety": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {"type": "array", "items": {"type": "string"}},
    "agents": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}}
  }
}
