{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipubs-cloud.github.io/open-flow/schemas/workflow.schema.json",
  "title": "Open Workflow Framework Workflow",
  "type": "object",
  "required": ["id", "name", "version", "purpose", "steps"],
  "properties": {
    "id": {"type": "string", "pattern": "^OWF-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "mode": {"enum": ["observe", "plan", "guided", "assisted", "autonomous"]},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "action"], "properties": {"id": {"type": "string"}, "action": {"type": "string"}}}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "gates": {"type": "array", "items": {"type": "string"}},
    "safety": {"type": "object", "additionalProperties": {"type": ["string", "boolean", "number", "array"]}}
  },
  "additionalProperties": true
}
