{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipubs-cloud.github.io/open-flow/schemas/workflow.schema.json",
  "title": "Open Workflow Framework Workflow",
  "type": "object",
  "required": ["id", "name", "version", "purpose"],
  "properties": {
    "id": {"type": "string", "pattern": "^OWF-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["atomic", "composite"], "default": "atomic"},
    "mode": {"type": "string", "enum": ["observe", "plan", "guided", "assisted", "autonomous"]},
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"type": "object", "minProperties": 1, "maxProperties": 1}
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "outputs": {"type": "array", "items": {"type": "string"}},
    "pipeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "workflow"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "workflow": {"type": "string", "pattern": "^OWF-[0-9]{3}$"},
          "name": {"type": "string"},
          "mode": {"type": "string", "enum": ["observe", "plan", "guided", "assisted", "autonomous"]},
          "with": {"type": "object"},
          "artifacts_produced": {"type": "array", "items": {"type": "string"}},
          "gate": {"$ref": "#/$defs/gate"}
        },
        "additionalProperties": true
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "artifact"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "artifact": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "safety": {"type": "object", "additionalProperties": true},
    "mermaid": {"type": "string"},
    "copilot_plan": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "composite"}}, "required": ["type"]},
      "then": {"required": ["pipeline", "bindings", "gates"]}
    },
    {
      "if": {"properties": {"type": {"const": "atomic"}}, "required": ["type"]},
      "then": {"required": ["steps"]}
    }
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["type", "before_step"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["manual_approval", "automated_test", "diff_inspection"]},
        "before_step": {"type": "integer", "minimum": 1},
        "reason": {"type": "string"},
        "prompt": {"type": "string"},
        "approval_env": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
