{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipubs-cloud.github.io/open-flow/schemas/registry.schema.json",
  "title": "OWF Workflow Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "spec", "description", "modes", "defaults", "workflows"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "spec": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["observe", "plan", "guided", "assisted", "autonomous"]}},
    "defaults": {
      "type": "object",
      "required": ["mode", "require_tests", "require_review", "destructive_operations"],
      "properties": {
        "mode": {"enum": ["observe", "plan", "guided", "assisted", "autonomous"]},
        "require_tests": {"type": "boolean"},
        "require_review": {"type": "boolean"},
        "destructive_operations": {"type": "boolean"}
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^OWF-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
