{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipubs-cloud.github.io/open-flow/schemas/registry.schema.json",
  "title": "AIPubs Open Flow Workflow Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry", "workflows"],
  "properties": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema", "manifest_root", "discovery", "lifecycle"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "schema": {"type": "string", "minLength": 1},
        "manifest_root": {"type": "string", "minLength": 1},
        "discovery": {"const": "filesystem"},
        "lifecycle": {"type": "object", "minProperties": 4}
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "version", "category", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^(OWF-[0-9]{3}|AIPUBS-[A-Z0-9]+-[0-9]{3})$"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
          "category": {"type": "string", "minLength": 1},
          "status": {"enum": ["experimental", "active", "deprecated", "retired"]},
          "replacement": {"type": "string", "pattern": "^(OWF-[0-9]{3}|AIPUBS-[A-Z0-9]+-[0-9]{3})$"}
        }
      }
    }
  }
}
