{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aipubs-cloud/open-flow/blob/main/schemas/skill.schema.json",
  "title": "OWF Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "procedure", "verification"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "procedure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
